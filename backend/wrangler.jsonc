{
  "name": "octo-oracle",
  "main": "../dist/server/index.js",
  "compatibility_date": "2026-09-12",
  "assets": {"directory": "../dist/client", "binding": "ASSETS", "run_worker_first": true},
  "routes": [
    {"pattern": "octooracle.app", "custom_domain": true},
    {"pattern": "www.octooracle.app", "custom_domain": true}
  ],
  "triggers": {"crons": ["0 * * * *"]},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "octo-oracle-production",
      "database_id": "24d4d642-7130-400b-99ba-3a1e05ac6a60",
      "migrations_dir": "../drizzle"
    }
  ]
}
